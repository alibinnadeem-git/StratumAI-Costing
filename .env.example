# Neon Postgres — configure these only in Vercel or your local .env file.
# Production database provisioned for this app: stratum_ai_costing
DATABASE_URL="<set-in-vercel>"
DIRECT_URL="<set-in-vercel>"

# Auth.js / NextAuth
AUTH_SECRET="<generate-in-vercel>"
AUTH_TRUST_HOST="true"
# Optional for local development. Vercel derives the host at runtime when trustHost is enabled.
NEXTAUTH_URL="http://localhost:3000"

# Resend (optional until outbound RFI/RFQ email is enabled)
RESEND_API_KEY="<optional>"
EMAIL_FROM="Stratum Electric <noreply@yourdomain.com>"

# Local/test seed only. Never configure this in production.
DEMO_PASSWORD="<set-only-for-local-seeding>"
